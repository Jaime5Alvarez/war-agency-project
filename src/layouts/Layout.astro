---
import "../styles/global.css";
import GridComponent from "../components/GridComponent.astro";
import { SEO } from "astro-seo";

export interface Props {
	title: string;
	description?: string;
	canonical?: string;
	noindex?: boolean;
}

const { 
	title, 
	description = "Experiencias militares reales en Polonia. Helicópteros, tanques, armamento auténtico y misiones personalizadas. Vive el combate real con instructores profesionales.",
	canonical,
	noindex = false
} = Astro.props;

// Structured Data for Local Business
const structuredData = {
	"@context": "https://schema.org",
	"@type": "TouristAttraction",
	"name": "Live Combat Experience",
	"description": description,
	"url": canonical || Astro.url.href,
	"telephone": "+34646640511",
	"address": {
		"@type": "PostalAddress",
		"addressCountry": "PL",
		"addressRegion": "Polonia"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": "52.2297",
		"longitude": "21.0122"
	},
	"image": "/images/samples/helicoptero.jpeg",
	"priceRange": "€€€",
	"currenciesAccepted": "EUR",
	"paymentAccepted": "Cash, Credit Card",
	"openingHours": "Mo-Su 09:00-18:00",
	"category": "Military Training Experience",
	"amenityFeature": [
		{
			"@type": "LocationFeatureSpecification",
			"name": "Helicopter Training",
			"value": true
		},
		{
			"@type": "LocationFeatureSpecification", 
			"name": "Tank Training",
			"value": true
		},
		{
			"@type": "LocationFeatureSpecification",
			"name": "Weapon Training",
			"value": true
		}
	],
	"aggregateRating": {
		"@type": "AggregateRating",
		"ratingValue": "4.8",
		"reviewCount": "150"
	}
};
---

<!doctype html>
<html lang="es" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		
		<SEO
			title={title}
			description={description}
			canonical={canonical}
			noindex={noindex}
			openGraph={{
				basic: {
					title: title,
					type: "website",
					image: "/images/samples/helicoptero.jpeg",
					url: canonical || Astro.url.href,
				},
				optional: {
					description: description,
					siteName: "Live Combat Experience",
					locale: "es_ES",
					localeAlternate: ["en_US", "pl_PL"],
				}
			}}
			twitter={{
				card: "summary_large_image",
				title: title,
				description: description,
				image: "/images/samples/helicoptero.jpeg",
				imageAlt: "Live Combat Experience - Entrenamiento militar real en Polonia",
			}}
			extend={{
				link: [
					{ rel: "icon", href: "/images/favicon.png" },
					{ rel: "manifest", href: "/manifest.json" },
					{ rel: "preconnect", href: "https://fonts.googleapis.com" },
					{ rel: "preconnect", href: "https://fonts.gstatic.com", crossorigin: "" },
				],
				meta: [
					{ name: "generator", content: Astro.generator },
					{ name: "keywords", content: "experiencia militar, combate real, entrenamiento militar, armamento real, Polonia, turismo militar, aventura extrema, helicópteros militares, tanques, rifle francotirador, instrucción militar profesional" },
					{ name: "author", content: "Live Combat Experience" },
					{ name: "language", content: "es" },
					{ name: "geo.region", content: "PL" },
					{ name: "geo.placename", content: "Polonia" },
					{ name: "geo.position", content: "52.2297;21.0122" },
					{ name: "ICBM", content: "52.2297, 21.0122" },
					{ name: "mobile-web-app-capable", content: "yes" },
					{ name: "apple-mobile-web-app-capable", content: "yes" },
					{ name: "apple-mobile-web-app-status-bar-style", content: "black-translucent" },
					{ name: "theme-color", content: "#030304" },
					{ name: "msapplication-navbutton-color", content: "#030304" },
					{ name: "apple-mobile-web-app-title", content: "Live Combat" },
					{ name: "format-detection", content: "telephone=no" },
					{ name: "robots", content: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" },
					{ name: "googlebot", content: "index, follow" },
					{ httpEquiv: "x-dns-prefetch-control", content: "on" },
				]
			}}
		/>
		
		<!-- Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	</head>
	<body class="bg-war-primary text-war-light antialiased relative">
		<GridComponent />
		<slot />
		
		<!-- WhatsApp Floating Button -->
		<a 
			href="https://wa.me/34646640511" 
			target="_blank" 
			rel="noopener noreferrer"
			class="fixed bottom-5 right-5 md:bottom-6 md:right-6 w-14 h-14 md:w-16 md:h-16 bg-green-500 hover:bg-green-600 rounded-full flex items-center justify-center text-white shadow-lg hover:shadow-xl transform hover:scale-110 transition-all duration-300 z-50"
			aria-label="Contactar por WhatsApp"
		>
			<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 md:w-7 md:h-7">
				<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.893 3.486"/>
			</svg>
		</a>
	</body>
</html>

<style>
	/* Reset and base responsive styles */
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		overflow-x: hidden;
	}
	
	* {
		box-sizing: border-box;
	}
	
	/* Smooth scroll with better performance */
	html {
		scroll-behavior: smooth;
		scroll-padding-top: 4rem; /* Account for sticky navbar */
	}
	
	/* Support for safe area insets (iPhone X+ notch) */
	body {
		padding-left: env(safe-area-inset-left);
		padding-right: env(safe-area-inset-right);
	}
	
	/* Improved scrollbar for different screen sizes */
	::-webkit-scrollbar {
		width: 6px;
	}
	
	@media (min-width: 1024px) {
		::-webkit-scrollbar {
			width: 8px;
		}
	}
	
	::-webkit-scrollbar-track {
		background: var(--color-war-primary);
	}
	
	::-webkit-scrollbar-thumb {
		background: var(--color-war-medium);
		border-radius: 4px;
	}
	
	::-webkit-scrollbar-thumb:hover {
		background: var(--color-war-light);
	}
	
	/* Performance optimizations */
	img, video {
		max-width: 100%;
		height: auto;
	}
	
	/* Reduce motion for users who prefer it */
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
		
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
		}
	}
	
	/* Dark mode support */
	@media (prefers-color-scheme: dark) {
		:root {
			color-scheme: dark;
		}
	}
	
	/* Focus management for better accessibility */
	*:focus {
		outline: 2px solid var(--color-war-light);
		outline-offset: 2px;
	}
	
	/* High contrast mode support */
	@media (prefers-contrast: high) {
		:root {
			--color-war-light: #ffffff;
			--color-war-medium: #999999;
			--color-war-primary: #000000;
		}
	}
	
	/* Touch device optimizations */
	@media (hover: none) and (pointer: coarse) {
		/* Increase touch targets */
		button, a {
			min-height: 44px;
			min-width: 44px;
		}
		
		/* Remove hover states that don't work on touch */
		.hover\:scale-105:hover {
			transform: none;
		}
	}
	
	/* Print styles */
	@media print {
		* {
			background: white !important;
			color: black !important;
			box-shadow: none !important;
		}
		
		nav, .no-print {
			display: none !important;
		}
		
		body {
			font-size: 12pt;
			line-height: 1.4;
		}
	}
</style>
