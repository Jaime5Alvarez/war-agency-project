<script>
  document.addEventListener('DOMContentLoaded', function() {
    const video = document.getElementById('showcase-video') as HTMLVideoElement;
    const customPlayBtn = document.getElementById('custom-play-btn');
    const fullscreenBtn = document.getElementById('fullscreen-btn');
    const qualityBtn = document.getElementById('quality-btn');
    const durationSpan = document.getElementById('video-duration');

    if (!video) return;

    // Manejar botón de play personalizado
    if (customPlayBtn) {
      customPlayBtn.addEventListener('click', () => {
        video.play();
        customPlayBtn.style.display = 'none';
      });
    }

    // Mostrar/ocultar botón de play personalizado
    video.addEventListener('play', () => {
      if (customPlayBtn) customPlayBtn.style.display = 'none';
    });

    video.addEventListener('pause', () => {
      if (customPlayBtn) customPlayBtn.style.display = 'flex';
    });

    video.addEventListener('ended', () => {
      if (customPlayBtn) customPlayBtn.style.display = 'flex';
    });

    // Actualizar duración del video
    video.addEventListener('loadedmetadata', () => {
      if (durationSpan) {
        const minutes = Math.floor(video.duration / 60);
        const seconds = Math.floor(video.duration % 60);
        durationSpan.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
      }
    });

    // Botón de pantalla completa
    if (fullscreenBtn) {
      fullscreenBtn.addEventListener('click', () => {
        if (video.requestFullscreen) {
          video.requestFullscreen();
        } else if ((video as any).webkitRequestFullscreen) {
          (video as any).webkitRequestFullscreen();
        } else if ((video as any).msRequestFullscreen) {
          (video as any).msRequestFullscreen();
        }
      });
    }

    // Botón de calidad (placeholder para funcionalidad futura)
    if (qualityBtn) {
      qualityBtn.addEventListener('click', () => {
        // Aquí podrías implementar cambio de calidad si tienes múltiples versiones
        qualityBtn.textContent = qualityBtn.textContent === '🎬 HD Quality' ? '🎬 4K Quality' : '🎬 HD Quality';
      });
    }

    // Intersection Observer para autoplay cuando sea visible
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && video.paused) {
          // Opcional: reproducir automáticamente cuando sea visible
          // video.play();
        }
      });
    }, { threshold: 0.5 });

    observer.observe(video);
  });
</script>

<style>
  /* Efectos visuales adicionales */
  #showcase-video {
    filter: contrast(1.1) saturate(1.1);
  }

  /* Animación sutil del botón de play */
  #custom-play-btn svg {
    animation: pulse-play 2s ease-in-out infinite;
  }

  @keyframes pulse-play {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
  }

  /* Efecto de brillo en el video */
  .aspect-video::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    animation: video-shine 4s linear infinite;
    z-index: 10;
    pointer-events: none;
  }

  @keyframes video-shine {
    0% { left: -100%; }
    100% { left: 100%; }
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    #custom-play-btn .w-20 {
      width: 4rem;
      height: 4rem;
    }
    
    #custom-play-btn svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }
</style> 