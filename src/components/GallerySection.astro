<script>
  // Funcionalidad de filtros de galería
  document.addEventListener('DOMContentLoaded', function() {
    const filterButtons = document.querySelectorAll('[data-filter]');
    const galleryItems = document.querySelectorAll('.gallery-item');

    filterButtons.forEach(button => {
      button.addEventListener('click', function(this: HTMLElement) {
        const filter = this.getAttribute('data-filter');
        
        // Actualizar botones activos
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-war-light', 'text-war-primary');
          btn.classList.add('bg-transparent', 'text-war-light', 'border-war-medium');
        });
        
        this.classList.remove('bg-transparent', 'text-war-light', 'border-war-medium');
        this.classList.add('bg-war-light', 'text-war-primary', 'border-war-light');
        
        // Filtrar elementos
        galleryItems.forEach(item => {
          const category = item.getAttribute('data-category');
          const htmlItem = item as HTMLElement;
          
          if (filter === 'all' || category === filter) {
            htmlItem.style.display = 'block';
            htmlItem.style.opacity = '0';
            setTimeout(() => {
              htmlItem.style.opacity = '1';
            }, 100);
          } else {
            htmlItem.style.opacity = '0';
            setTimeout(() => {
              htmlItem.style.display = 'none';
            }, 300);
          }
        });
      });
    });

    // Funcionalidad de videos
    const videos = document.querySelectorAll('video');
    
    videos.forEach(video => {
      video.addEventListener('click', function(this: HTMLVideoElement) {
        if (this.paused) {
          this.play();
          // Ocultar el overlay de play si existe
          const overlay = this.parentElement?.querySelector('.absolute.inset-0.bg-black\\/50') as HTMLElement;
          if (overlay) overlay.style.display = 'none';
        } else {
          this.pause();
        }
      });

      // Mostrar controles al hacer hover
      video.addEventListener('mouseenter', function(this: HTMLVideoElement) {
        this.setAttribute('controls', 'true');
      });

      video.addEventListener('mouseleave', function(this: HTMLVideoElement) {
        if (this.paused) {
          this.removeAttribute('controls');
        }
      });

      // Reiniciar overlay cuando termine el video
      video.addEventListener('ended', function(this: HTMLVideoElement) {
        const overlay = this.parentElement?.querySelector('.absolute.inset-0.bg-black\\/50') as HTMLElement;
        if (overlay) overlay.style.display = 'flex';
        this.removeAttribute('controls');
      });
    });

    // Lazy loading para videos
    const videoElements = document.querySelectorAll('video[preload="metadata"]');
    
    if ('IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const video = entry.target as HTMLVideoElement;
            video.preload = 'metadata';
            videoObserver.unobserve(video);
          }
        });
      });

      videoElements.forEach(video => {
        videoObserver.observe(video);
      });
    }
  });
</script>


