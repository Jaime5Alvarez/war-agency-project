<script>
  // Funcionalidad de filtros de galería y lightbox
  document.addEventListener('DOMContentLoaded', function() {
    const filterButtons = document.querySelectorAll('[data-filter]');
    const galleryItems = document.querySelectorAll('.gallery-item');
    const modal = document.getElementById('galleryModal');
    const modalContent = document.getElementById('modalContent');
    const modalTitle = document.getElementById('modalTitle');
    const modalDescription = document.getElementById('modalDescription');
    const modalCategory = document.getElementById('modalCategory');
    const closeModal = document.getElementById('closeModal');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    
    let currentItemIndex = 0;
    let visibleItems = [];

    // Función para obtener elementos visibles
    function getVisibleItems() {
      return Array.from(galleryItems).filter(item => {
        const style = window.getComputedStyle(item);
        return style.display !== 'none' && style.opacity !== '0';
      });
    }

    // Funcionalidad de filtros
    filterButtons.forEach(button => {
      button.addEventListener('click', function(this: HTMLElement) {
        const filter = this.getAttribute('data-filter');
        
        // Actualizar botones activos
        filterButtons.forEach(btn => {
          btn.classList.remove('bg-war-light', 'text-war-primary');
          btn.classList.add('bg-transparent', 'text-war-light', 'border-war-medium');
        });
        
        this.classList.remove('bg-transparent', 'text-war-light', 'border-war-medium');
        this.classList.add('bg-war-light', 'text-war-primary', 'border-war-light');
        
        // Filtrar elementos
        galleryItems.forEach(item => {
          const category = item.getAttribute('data-category');
          const htmlItem = item as HTMLElement;
          
          if (filter === 'all' || category === filter) {
            htmlItem.style.display = 'block';
            htmlItem.style.opacity = '0';
            setTimeout(() => {
              htmlItem.style.opacity = '1';
            }, 100);
          } else {
            htmlItem.style.opacity = '0';
            setTimeout(() => {
              htmlItem.style.display = 'none';
            }, 300);
          }
        });

        // Actualizar elementos visibles para navegación
        setTimeout(() => {
          visibleItems = getVisibleItems();
        }, 400);
      });
    });

    // Función para abrir el modal
    function openModal(index: number) {
      visibleItems = getVisibleItems();
      currentItemIndex = index;
      
      const item = visibleItems[currentItemIndex];
      const video = item.querySelector('video') as HTMLVideoElement;
      const img = item.querySelector('img') as HTMLImageElement;
      
      // Limpiar contenido anterior
      modalContent!.innerHTML = '';
      
      // Obtener información del elemento
      const infoDiv = item.querySelector('.absolute.bottom-0') as HTMLElement;
      const titleElement = infoDiv?.querySelector('p:first-child') as HTMLElement;
      const descElement = infoDiv?.querySelector('p:last-child') as HTMLElement;
      const category = item.getAttribute('data-category');
      
      // Actualizar información del modal
      if (modalTitle) modalTitle.textContent = titleElement?.textContent || '';
      if (modalDescription) modalDescription.textContent = descElement?.textContent || '';
      if (modalCategory) {
        modalCategory.textContent = category === 'weapons' ? 'ARMAMENTO' : 
                                   category === 'vehicles' ? 'VEHÍCULOS' : 'ESCENARIOS';
      }
      
      if (video) {
        // Crear nuevo elemento de video para el modal
        const modalVideo = document.createElement('video');
        modalVideo.className = 'max-w-full max-h-full w-full sm:w-auto object-contain rounded-lg shadow-2xl';
        modalVideo.controls = true;
        modalVideo.autoplay = true;
        modalVideo.src = video.querySelector('source')?.src || '';
        
        modalContent!.appendChild(modalVideo);
      } else if (img) {
        // Crear nuevo elemento de imagen para el modal
        const modalImg = document.createElement('img');
        modalImg.className = 'max-w-full max-h-full w-full sm:w-auto object-contain rounded-lg shadow-2xl';
        modalImg.src = img.src;
        modalImg.alt = img.alt;
        
        modalContent!.appendChild(modalImg);
      }
      
      // Mostrar modal
      modal!.classList.remove('hidden');
      modal!.classList.add('flex');
      document.body.style.overflow = 'hidden';
      
      // Actualizar visibilidad de botones de navegación
      updateNavigationButtons();
    }

    // Función para cerrar el modal
    function closeModalFunction() {
      modal!.classList.add('hidden');
      modal!.classList.remove('flex');
      document.body.style.overflow = '';
      
      // Pausar videos si hay alguno reproduciéndose
      const modalVideo = modalContent!.querySelector('video') as HTMLVideoElement;
      if (modalVideo) {
        modalVideo.pause();
      }
    }

    // Función para navegación
    function navigateModal(direction: number) {
      const newIndex = currentItemIndex + direction;
      if (newIndex >= 0 && newIndex < visibleItems.length) {
        openModal(newIndex);
      }
    }

    // Función para actualizar botones de navegación
    function updateNavigationButtons() {
      if (prevBtn) prevBtn.style.display = currentItemIndex > 0 ? 'flex' : 'none';
      if (nextBtn) nextBtn.style.display = currentItemIndex < visibleItems.length - 1 ? 'flex' : 'none';
    }

    // Event listeners para elementos de galería
    galleryItems.forEach((item, index) => {
      // Remover los overlays de play existentes ya que ahora abriremos el modal
      const playOverlay = item.querySelector('.absolute.inset-0.bg-black\\/50');
      if (playOverlay) {
        playOverlay.remove();
      }
      
      // Hacer toda la tarjeta clickeable
      item.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        // Obtener el índice entre los elementos visibles
        visibleItems = getVisibleItems();
        const visibleIndex = visibleItems.indexOf(item as Element);
        if (visibleIndex !== -1) {
          openModal(visibleIndex);
        }
      });
      
      // Agregar cursor pointer
      (item as HTMLElement).style.cursor = 'pointer';
    });

    // Event listeners para el modal
    closeModal?.addEventListener('click', closeModalFunction);
    prevBtn?.addEventListener('click', () => navigateModal(-1));
    nextBtn?.addEventListener('click', () => navigateModal(1));

    // Cerrar modal al hacer clic fuera del contenido
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModalFunction();
      }
    });

    // Navegación con teclado
    document.addEventListener('keydown', (e) => {
      if (!modal?.classList.contains('hidden')) {
        switch(e.key) {
          case 'Escape':
            closeModalFunction();
            break;
          case 'ArrowLeft':
            navigateModal(-1);
            break;
          case 'ArrowRight':
            navigateModal(1);
            break;
        }
      }
    });

    // Soporte para gestos táctiles
    let touchStartX = 0;
    let touchEndX = 0;

    modal?.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    });

    modal?.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    });

    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;
      
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          // Swipe izquierda - siguiente
          navigateModal(1);
        } else {
          // Swipe derecha - anterior
          navigateModal(-1);
        }
      }
    }

    // Mejorar responsive en redimensionado
    window.addEventListener('resize', () => {
      if (!modal?.classList.contains('hidden')) {
        // Reposicionar modal content si es necesario
        const modalVideo = modalContent?.querySelector('video') as HTMLVideoElement;
        const modalImg = modalContent?.querySelector('img') as HTMLImageElement;
        
        if (modalVideo) {
          modalVideo.style.maxWidth = '100%';
          modalVideo.style.maxHeight = '100%';
        }
        if (modalImg) {
          modalImg.style.maxWidth = '100%';
          modalImg.style.maxHeight = '100%';
        }
      }
    });

    // Inicializar elementos visibles
    visibleItems = getVisibleItems();

    // Lazy loading para videos (mantener funcionalidad original)
    const videoElements = document.querySelectorAll('video[preload="metadata"]');
    
    if ('IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const video = entry.target as HTMLVideoElement;
            video.preload = 'metadata';
            videoObserver.unobserve(video);
          }
        });
      });

      videoElements.forEach(video => {
        videoObserver.observe(video);
      });
    }
  });
</script>


