  <!-- Modal/Lightbox para galería -->
  <div id="galleryModal" class="fixed inset-0 bg-black/95 backdrop-blur-sm z-50 hidden items-center justify-center p-2 sm:p-4">
    <div class="relative max-w-7xl max-h-full w-full h-full flex items-center justify-center">
      
      <!-- Botón de cerrar -->
      <button id="closeModal" class="absolute top-2 right-2 sm:top-4 sm:right-4 z-60 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-war-light hover:bg-war-white transition-colors duration-300 flex items-center justify-center group">
        <span class="text-war-primary text-lg sm:text-xl font-bold group-hover:scale-110 transition-transform duration-300">✕</span>
      </button>
      
      <!-- Información del contenido -->
      <div id="modalInfo" class="absolute top-2 left-2 sm:top-4 sm:left-4 z-60 bg-black/80 backdrop-blur-sm rounded-lg p-3 sm:p-4 max-w-[calc(100vw-120px)] sm:max-w-md">
        <h3 id="modalTitle" class="text-sm sm:text-lg font-bold uppercase text-war-light mb-1 sm:mb-2 leading-tight"></h3>
        <p id="modalDescription" class="text-xs sm:text-sm text-war-medium leading-tight"></p>
        <div id="modalCategory" class="inline-block mt-1 sm:mt-2 px-2 sm:px-3 py-1 bg-war-medium/30 rounded-full text-xs uppercase font-bold text-war-light"></div>
      </div>

      <!-- Controles de navegación -->
      <button id="prevBtn" class="absolute left-2 sm:left-4 top-1/2 transform -translate-y-1/2 z-60 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-war-light/80 hover:bg-war-light transition-colors duration-300 flex items-center justify-center group">
        <span class="text-war-primary text-lg sm:text-xl font-bold group-hover:scale-110 transition-transform duration-300">‹</span>
      </button>
      
      <button id="nextBtn" class="absolute right-2 sm:right-4 top-1/2 transform -translate-y-1/2 z-60 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-war-light/80 hover:bg-war-light transition-colors duration-300 flex items-center justify-center group">
        <span class="text-war-primary text-lg sm:text-xl font-bold group-hover:scale-110 transition-transform duration-300">›</span>
      </button>

      <!-- Contenedor del contenido -->
      <div id="modalContent" class="w-full h-full flex items-center justify-center p-12 sm:p-16 md:p-20">
        <!-- El contenido se insertará aquí dinámicamente -->
      </div>
      
    </div>
