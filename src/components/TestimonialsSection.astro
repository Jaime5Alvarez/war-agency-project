---

<section id="testimonios" class="py-20 px-6 bg-gradient-to-br from-war-dark via-war-primary to-war-dark relative overflow-hidden">
  <div class="max-w-7xl mx-auto">
    
    <!-- Encabezado -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-6xl font-black mb-6 tracking-tight text-war-light font-mono uppercase">
        LO QUE DICE <span class="text-war-warm">NUESTRA COMUNIDAD</span>
      </h2>
      <p class="text-xl text-war-medium max-w-3xl mx-auto leading-relaxed">
        Descubre las experiencias reales de quienes ya han vivido la adrenalina de nuestras actividades militares
      </p>
    </div>

    <!-- Masonry Grid al estilo Flowbite -->
    <!-- Vista móvil: Scroll horizontal -->
    <div class="block md:hidden mb-16">
      <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory scroll-smooth [-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
        {/* Combinamos todos los testimonios en un array para móviles */}
        {[...testimonials.column1, ...testimonials.column2, ...testimonials.column3, ...testimonials.column4].map((testimonial) => (
          <div class="flex-none w-80 snap-center">
            <div class="group relative h-full">
              <div class="bg-war-primary/90  border border-war-medium/30 rounded-lg p-6 transition-all duration-300 hover:border-war-warm/50 hover:bg-war-primary/95 hover:transform hover:scale-[1.02] h-full">
                
                <!-- Header con avatar y datos -->
                <div class="flex items-center mb-4">
                  <img 
                    src={testimonial.avatar} 
                    alt={testimonial.name}
                    class="w-12 h-12 rounded-full object-cover mr-3 ring-2 ring-war-medium/30 blur-xs hover:blur-none transition-all duration-300"
                  />
                  <div class="flex-1">
                    <div class="flex items-center gap-2">
                      <h4 class="font-bold text-war-white text-sm">{testimonial.name}</h4>
                      {testimonial.verified && (
                        <div class="bg-war-warm/20 text-war-warm text-xs px-2 py-1 rounded-full border border-war-warm/30">
                          ✓ VERIFICADO
                        </div>
                      )}
                    </div>
                    <p class="text-war-light/70 text-xs">{testimonial.country}</p>
                  </div>
                </div>

                <!-- Contenido del testimonio -->
                <div class="mb-4">
                  <p class="text-war-light leading-relaxed text-sm mb-3">
                    "{testimonial.text}"
                  </p>
                  
                  <!-- Tag de experiencia -->
                  <div class="inline-block bg-war-cool/20 text-war-cool text-xs px-3 py-1 rounded-full border border-war-cool/30">
                    {testimonial.experience}
                  </div>
                </div>

                <!-- Rating -->
                <div class="flex items-center gap-1 text-war-gold">
                  <span class="font-mono text-sm font-black">[ ★★★★★ ]</span>
                  <span class="text-xs text-war-medium ml-2">5.0</span>
                </div>

                <!-- Efecto de hover -->
                <div class="absolute inset-0 rounded-lg bg-gradient-to-r from-war-warm/0 via-war-warm/5 to-war-warm/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>
              </div>
            </div>
          </div>
        ))}
      </div>
      
    </div>

    <!-- Vista desktop: Grid original -->
    <div class="hidden md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
      
      <!-- Columna 1 -->
      <div class="grid gap-4">
